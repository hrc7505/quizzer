generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  phoneNumber   String?       @unique
  role          String        @default("USER")
  accounts      Account[]
  attempts      QuizAttempt[]
  sessions      Session[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  topics      Topic[]  @relation("ExamTopics")
}

model Topic {
  id           String     @id @default(uuid())
  title        String
  language     String     @default("en")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  description  String?
  questions    Question[]
  exams        Exam[]     @relation("ExamTopics")
  parentTopics Topic[]    @relation("TopicHierarchy")
  subtopics    Topic[]    @relation("TopicHierarchy")
  quizzes      Quiz[]     @relation("TopicQuizzes")

  @@index([language])
}

model Quiz {
  id         String        @id @default(uuid())
  title      String
  language   String        @default("en")
  quizOrder  Int           @default(1)
  difficulty String        @default("Medium")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  questions  Question[]
  attempts   QuizAttempt[]
  topics     Topic[]       @relation("TopicQuizzes")

  @@index([language])
  @@index([difficulty])
}

model Question {
  id            String   @id @default(uuid())
  topicId       String
  quizId        String?
  language      String   @default("en")
  text          String
  imageUrl      String?
  invertInDark  Boolean  @default(true)
  options       String[]
  correctAnswer String
  hint          String
  description   String
  elaboration   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  quiz          Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, language])
  @@index([topicId])
  @@index([language])
}

model QuizAttempt {
  id              String       @id @default(uuid())
  quizId          String
  scorePercentage Float        @default(0.0)
  correctCount    Int          @default(0)
  wrongCount      Int          @default(0)
  timeTakenSec    Int          @default(0)
  createdAt       DateTime     @default(now())
  completed       Boolean      @default(false)
  userId          String?
  quiz            Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         UserAnswer[]

  @@index([quizId, completed])
  @@index([userId])
}

model UserAnswer {
  id             String      @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

model QuizBatch {
  id           String    @id @default(uuid())
  topicId      String?
  title        String
  language     String    @default("en")
  difficulty   String    @default("Medium")
  rawText      String    @db.Text
  batchIndex   Int       @default(1)
  totalBatches Int       @default(1)
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PAUSED
  error        String?
  padTo30      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([topicId])
  @@index([language])
}
